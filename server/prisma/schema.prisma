generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        RoleName     @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
}

enum RoleName {
  ADMINISTRATOR
  LECTURER
  STUDENT
}

model Permission {
  id          Int              @id @default(autoincrement())
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id              Int       @id @default(autoincrement())
  studentId       String?   @unique
  staffId         String?   @unique
  firstName       String
  lastName        String
  email           String    @unique
  passwordHash    String
  roleId          Int
  role            Role      @relation(fields: [roleId], references: [id])
  department      String?
  isActive        Boolean   @default(true)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lecturedCourses     Course[]       @relation("LecturerCourses")
  enrollments         Enrollment[]
  submittedGrades     Grade[]        @relation("GradeSubmitter")
  approvedGrades      Grade[]        @relation("GradeApprover")
  auditLogs           AuditLog[]
  sessions            Session[]
  separationViolations SeparationOfDutyLog[]

  @@index([email])
  @@index([roleId])
}

model Session {
  id           String    @id @default(uuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  courses     Course[]
  createdAt   DateTime @default(now())
}

model AcademicPeriod {
  id            Int       @id @default(autoincrement())
  name          String
  startDate     DateTime
  endDate       DateTime
  gradingOpen   DateTime
  gradingClose  DateTime
  isActive      Boolean   @default(false)
  courses       Course[]
  createdAt     DateTime  @default(now())
}

model Course {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  title            String
  credits          Int            @default(3)
  departmentId     Int
  department       Department     @relation(fields: [departmentId], references: [id])
  lecturerId       Int
  lecturer         User           @relation("LecturerCourses", fields: [lecturerId], references: [id])
  academicPeriodId Int
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  isActive         Boolean        @default(true)
  enrollments      Enrollment[]
  grades           Grade[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([lecturerId])
  @@index([departmentId])
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  studentId   Int
  student     User      @relation(fields: [studentId], references: [id])
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id])
  enrolledAt  DateTime  @default(now())
  status      EnrollmentStatus @default(ACTIVE)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

model Grade {
  id              Int         @id @default(autoincrement())
  studentId       Int
  courseId        Int
  submitterId     Int
  approverId      Int?
  score           Float
  grade           String
  remarks         String?
  status          GradeStatus @default(DRAFT)
  submittedAt     DateTime    @default(now())
  approvedAt      DateTime?

  student         User   @relation(fields: [studentId], references: [id])
  course          Course @relation(fields: [courseId], references: [id])
  submitter       User   @relation("GradeSubmitter", fields: [submitterId], references: [id])
  approver        User?  @relation("GradeApprover", fields: [approverId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([submitterId])
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model AuditLog {
  id              Int              @id @default(autoincrement())
  userId          Int?
  user            User?            @relation(fields: [userId], references: [id])
  action          String
  resource        String
  resourceId      String?
  outcome         AuditOutcome
  denyReason      DenyReason?
  ipAddress       String?
  userAgent       String?
  requestPath     String?
  metadata        Json?
  timestamp       DateTime         @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([outcome])
}

enum AuditOutcome {
  GRANTED
  DENIED_ROLE
  DENIED_RELATIONSHIP
  DENIED_CONTEXT
  DENIED_SOD
  ERROR
}

enum DenyReason {
  INSUFFICIENT_ROLE
  NO_ACADEMIC_RELATIONSHIP
  OUTSIDE_GRADING_PERIOD
  SEPARATION_OF_DUTY_VIOLATION
  ACCOUNT_LOCKED
  SESSION_EXPIRED
  RESOURCE_NOT_FOUND
}

model SeparationOfDutyLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  violation   String
  attempted   String
  blocked     Boolean  @default(true)
  timestamp   DateTime @default(now())
}

model ContextPolicy {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String
  resource    String
  action      String
  condition   Json
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
}

